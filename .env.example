# GEMINI_API_KEY: Optional/fallback direct Gemini API key for client-side tools if backend is bypassed
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# External Backend URLs for Student Frontend (Vercel SPA)
# VITE_API_URL: External REST API base URL (e.g. https://api.cherryai.app or http://localhost:3000)
VITE_API_URL=""

# VITE_WS_URL: External WebSocket base URL (e.g. wss://api.cherryai.app or ws://localhost:3000)
VITE_WS_URL=""
